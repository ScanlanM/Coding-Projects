# Twitch application credentials: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# One-time authorization code from get_twitch_user_consent_index.html.
# Only needed for the very first run; after that the app refreshes its
# own token automatically and this can be left blank.
MY_AUTH_TWITCH_CODE=

# Twitch user id of the account granting consent, and the broadcaster
# whose chat you want to read.
TWITCH_USER_ID=
TARGET_BROADCASTER=

# ElevenLabs
ELEVENLABS_API_KEY=
